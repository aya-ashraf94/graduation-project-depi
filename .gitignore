# Repository-wide ignore rules for the full-stack project.

# Dependencies
node_modules/
Frontend/node_modules/
Backend/node_modules/

# Build outputs
Frontend/dist/
Frontend/out-tsc/
Frontend/tmp/
Frontend/bazel-out/
Frontend/.angular/cache/
Frontend/coverage/
Backend/dist/
Backend/build/
Backend/tmp/
Backend/coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
testem.log
libpeerconnection.log

# Environment and secrets
Backend/.env
Backend/.env.*
!Backend/.env.example

# IDEs and editors
.vscode/
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/

# Miscellaneous caches and temp files
.cache/
.eslintcache
.nyc_output/
.sass-cache/
connect.lock
typings/
__screenshots__/

# System files
.DS_Store
Thumbs.db

# Uploaded images
Backend/public/uploads/

# Documentation and Blueprints
docs/